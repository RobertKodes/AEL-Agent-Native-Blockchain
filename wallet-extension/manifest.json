{
  "manifest_version": 3,
  "name": "AEL Wallet",
  "version": "0.7.0",
  "description": "Self-custodied AEL devnet wallet and consent-gated dApp intent signer.",
  "permissions": ["storage"],
  "host_permissions": ["https://ael-network-production.up.railway.app/*", "http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "AEL Wallet", "default_popup": "popup.html"},
  "homepage_url": "https://ael-network-production.up.railway.app/wallet",
  "content_scripts": [{"matches":["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],"js":["content.js"],"run_at":"document_start"}],
  "web_accessible_resources": [{"resources":["inpage.js"],"matches":["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]}],
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; base-uri 'none'"}
}
